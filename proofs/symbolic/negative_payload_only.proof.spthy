theory SACReDPayloadOnlyMutation

begin

// Function signature and definition of the equational theory E

functions: fst/1, mac/2, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Issue:
   [
   Fr( ~key ), Fr( ~ctx ), Fr( ~rho ), Fr( ~caller ), Fr( ~service ),
   Fr( ~dc ), Fr( ~ds ), Fr( ~sid ), Fr( ~action ), Fr( ~vector ),
   In( payload )
   ]
  --[
  Issued( ~key,
          <~ctx, ~rho, ~caller, ~service, ~dc, ~ds, ~sid, ~action, payload, ~vector
          >
  )
  ]->
   [
   !Key( ~key ),
   Out( <
         <~ctx, ~rho, ~caller, ~service, ~dc, ~ds, ~sid, ~action, payload, ~vector
         >, 
         mac(~key, payload)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Accept:
   [
   !Key( key ),
   In( <<ctx, rho, caller, service, dc, ds, sid, action, payload, vector>, 
        mac(key, payload)>
   )
   ]
  --[
  Accepted( key,
            <ctx, rho, caller, service, dc, ds, sid, action, payload, vector>
  )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma complete_message_origin:
  all-traces
  "∀ key message #a.
    (Accepted( key, message ) @ #a) ⇒
    (∃ #i. (Issued( key, message ) @ #i) ∧ (#i < #a))"
/*
guarded formula characterizing all counter-examples:
"∃ key message #a.
  (Accepted( key, message ) @ #a)
 ∧
  ∀ #i. (Issued( key, message ) @ #i) ⇒ ¬(#i < #a)"
*/
simplify
solve( !Key( key ) ▶₀ #a )
  case Issue
  solve( !KU( mac(~key, payload) ) @ #vk.20 )
    case Issue
    SOLVED // trace found
  qed
qed

lemma accepted_request_exists:
  exists-trace "∃ key message #a. Accepted( key, message ) @ #a"
/*
guarded formula characterizing all satisfying traces:
"∃ key message #a. (Accepted( key, message ) @ #a)"
*/
simplify
solve( !Key( key ) ▶₀ #a )
  case Issue
  solve( !KU( mac(~key, payload) ) @ #vk.20 )
    case Issue
    SOLVED // trace found
  qed
qed

/* All wellformedness checks were successful. */

