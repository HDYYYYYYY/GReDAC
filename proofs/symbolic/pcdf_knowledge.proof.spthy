theory SACReDPCDFKnowledge

begin

// Function signature and definition of the equational theory E

functions: anchor_label/2, auth/2[private,constructor], fst/1,
           grant_label/1, pair/2, snd/1, spend_label/0, split_label/1, step/2
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

restriction UniqueEdge:
  "∀ parent label n1 k1 n2 k2 #i #j.
    ((EdgeCreated( parent, label, n1, k1 ) @ #i) ∧
     (EdgeCreated( parent, label, n2, k2 ) @ #j)) ⇒
    ((n1 = n2) ∧ (k1 = k2))"
  // safety formula

  /*
  expanded formula:
  "∀ parent label n1 k1 n2 k2 #i #j.
    ((EdgeCreated( parent, label, n1, k1 ) @ #i) ∧
     (EdgeCreated( parent, label, n2, k2 ) @ #j)) ⇒
    ((n1 = n2) ∧ (k1 = k2))"
  */

rule (modulo E) Source:
   [ Fr( ~s ), Fr( ~k ) ]
  --[ MasterCreated( ~s, ~k ), SeedBorn( ~s, ~k ) ]->
   [ !Master( ~s, ~k ), !Bit( '0' ), !Bit( '1' ), Out( ~s ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Anchor:
   [ !Master( s, master ), Fr( ~a ), Fr( ~key ), In( binding ) ]
  --[
  EdgeCreated( s, anchor_label(~a, binding), ~a, ~key ),
  AnchorCreated( s, ~a ), SeedBorn( ~a, ~key )
  ]->
   [
   !Node( s, ~a, ~a, 'root', ~key ),
   !Edge( s, anchor_label(~a, binding), ~a, master, ~key ), Out( ~a )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Split:
   [ !Node( s, a, n, p, key )[-], Fr( ~child ), Fr( ~ck ), !Bit( bit ) ]
  --[
  EdgeCreated( n, split_label(bit), ~child, ~ck ),
  SplitCreated( a, n, ~child, p, step(p, bit) ), SeedBorn( ~child, ~ck )
  ]->
   [
   !Node( s, a, ~child, step(p, bit), ~ck ),
   !Edge( n, split_label(bit), ~child, key, ~ck ), Out( ~child )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Grant:
   [ !Node( s, a, n, p, key )[-], Fr( ~child ), Fr( ~ck ), In( gid ) ]
  --[
  EdgeCreated( n, grant_label(gid), ~child, ~ck ),
  GrantCreated( a, n, ~child, gid, p, p ),
  GrantSeed( n, key, gid, ~child, ~ck ), SeedBorn( ~child, ~ck )
  ]->
   [
   !Node( s, a, ~child, p, ~ck ),
   !Edge( n, grant_label(gid), ~child, key, ~ck ), Out( ~child )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Spend:
   [ !Node( s, a, n, p, key )[-], Fr( ~child ), Fr( ~ck ) ]
  --[
  EdgeCreated( n, spend_label, ~child, ~ck ),
  SpendCreated( a, n, ~child, p ), SeedBorn( ~child, ~ck )
  ]->
   [
   !Business( s, a, ~child, ~ck ),
   !Edge( n, spend_label, ~child, key, ~ck ), Out( ~child )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) EdgeQuery:
   [ !Edge( parent, label, child, key, ck )[-], In( key )[+], In( label ) ]
  --[
  EdgeQueried( parent, label, child ),
  EdgeDisclosed( parent, key, label, child, ck )
  ]->
   [ Out( ck ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) RevealNode:
   [ !Node( s, a, n, p, key ) ]
  --[ SeedRevealed( s, a, n, key ) ]->
   [ Out( key ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) RevealSpend:
   [ !Business( s, a, n, key ) ]
  --[ SeedRevealed( s, a, n, key ) ]->
   [ Out( key ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) HonestTag:
   [ !Business( s, a, n, key ), In( m ) ]
  --[ TagIssued( s, a, n, m ) ]->
   [ Out( auth(key, m) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AuthQuery:
   [ In( key )[+], In( m ) ]
  --[ AuthQueried( key, m ) ]->
   [ Out( auth(key, m) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) VerifyTag:
   [ !Business( s, a, n, key ), In( <m, auth(key, m)> ) ]
  --[ TagAccepted( s, a, n, m ), AcceptedSeed( s, a, n, key ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) ProbeNode:
   [ !Node( s, a, n, p, key ), In( key ) ] --[ NodeKnown( s, a, n ) ]-> [ ]

  /* has exactly the trivial AC variant */

lemma master_secret [reuse]:
  all-traces
  "∀ s key #c #i. ((MasterCreated( s, key ) @ #c) ∧ (K( key ) @ #i)) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ s key #c #i. (MasterCreated( s, key ) @ #c) ∧ (K( key ) @ #i)"
*/
simplify
by solve( !KU( ~k ) @ #vk )

lemma seed_knowledge_causal_origin [reuse]:
  all-traces
  "∀ n key #b #i.
    ((SeedBorn( n, key ) @ #b) ∧ (K( key ) @ #i)) ⇒
    ((∃ s a #r. (SeedRevealed( s, a, n, key ) @ #r) ∧ (#r < #i)) ∨
     (∃ parent pk label #q #p.
       (((EdgeDisclosed( parent, pk, label, n, key ) @ #q) ∧ (K( pk ) @ #p)) ∧
        (#p < #q)) ∧
       (#q < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ n key #b #i.
  (SeedBorn( n, key ) @ #b) ∧ (K( key ) @ #i)
 ∧
  (∀ s a #r. (SeedRevealed( s, a, n, key ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ parent pk label #q #p.
    (EdgeDisclosed( parent, pk, label, n, key ) @ #q) ∧ (K( pk ) @ #p)
   ⇒
    ((¬(#p < #q)) ∨ (¬(#q < #i))))"
*/
simplify
solve( SeedBorn( n, key ) @ #b )
  case Anchor
  solve( !Master( s, master ) ▶₀ #b )
    case Source
    solve( !KU( ~key ) @ #vk )
      case EdgeQuery
      by contradiction /* from formulas */
    next
      case RevealNode
      by contradiction /* from formulas */
    qed
  qed
next
  case Grant
  solve( !KU( ~ck ) @ #vk )
    case EdgeQuery
    by contradiction /* from formulas */
  next
    case RevealNode
    by contradiction /* from formulas */
  qed
next
  case Source
  by contradiction /* from formulas */
next
  case Spend
  solve( !KU( ~ck ) @ #vk )
    case EdgeQuery_case_1
    by contradiction /* from formulas */
  next
    case EdgeQuery_case_2
    by contradiction /* from formulas */
  next
    case EdgeQuery_case_3
    by contradiction /* from formulas */
  next
    case EdgeQuery_case_4
    by contradiction /* from formulas */
  next
    case RevealSpend_case_1
    by contradiction /* from formulas */
  next
    case RevealSpend_case_2
    by contradiction /* from formulas */
  next
    case RevealSpend_case_3
    by contradiction /* from formulas */
  next
    case RevealSpend_case_4
    by contradiction /* from formulas */
  qed
next
  case Split
  solve( !Bit( bit ) ▶₃ #b )
    case Source_case_1
    solve( !KU( ~ck ) @ #vk )
      case EdgeQuery
      by contradiction /* from formulas */
    next
      case RevealNode
      by contradiction /* from formulas */
    qed
  next
    case Source_case_2
    solve( !KU( ~ck ) @ #vk )
      case EdgeQuery
      by contradiction /* from formulas */
    next
      case RevealNode
      by contradiction /* from formulas */
    qed
  qed
qed

lemma edge_query_requires_prior_parent_knowledge:
  all-traces
  "∀ parent pk label child ck #q.
    (EdgeDisclosed( parent, pk, label, child, ck ) @ #q) ⇒
    (∃ #p. (K( pk ) @ #p) ∧ (#p < #q))"
/*
guarded formula characterizing all counter-examples:
"∃ parent pk label child ck #q.
  (EdgeDisclosed( parent, pk, label, child, ck ) @ #q)
 ∧
  ∀ #p. (K( pk ) @ #p) ⇒ ¬(#p < #q)"
*/
simplify
by contradiction /* from formulas */

lemma authentication_has_issue_or_seed_query [reuse]:
  all-traces
  "∀ s a n m key #i.
    ((TagAccepted( s, a, n, m ) @ #i) ∧
     (AcceptedSeed( s, a, n, key ) @ #i)) ⇒
    ((∃ #j. (TagIssued( s, a, n, m ) @ #j) ∧ (#j < #i)) ∨
     (∃ #q #p.
       (((AuthQueried( key, m ) @ #q) ∧ (K( key ) @ #p)) ∧ (#p < #q)) ∧
       (#q < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ s a n m key #i.
  (TagAccepted( s, a, n, m ) @ #i) ∧ (AcceptedSeed( s, a, n, key ) @ #i)
 ∧
  (∀ #j. (TagIssued( s, a, n, m ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #q #p.
    (AuthQueried( key, m ) @ #q) ∧ (K( key ) @ #p)
   ⇒
    ((¬(#p < #q)) ∨ (¬(#q < #i))))"
*/
simplify
solve( !Business( s, a, n, key ) ▶₀ #i )
  case Spend_case_1
  solve( !KU( auth(~ck, m) ) @ #vk.2 )
    case AuthQuery
    by contradiction /* from formulas */
  next
    case HonestTag
    by contradiction /* from formulas */
  qed
next
  case Spend_case_2
  solve( !KU( auth(~ck, m) ) @ #vk.2 )
    case AuthQuery
    by contradiction /* from formulas */
  next
    case HonestTag
    by contradiction /* from formulas */
  qed
next
  case Spend_case_3
  solve( !KU( auth(~ck, m) ) @ #vk.2 )
    case AuthQuery
    by contradiction /* from formulas */
  next
    case HonestTag
    by contradiction /* from formulas */
  qed
next
  case Spend_case_4
  solve( !KU( auth(~ck, m) ) @ #vk.2 )
    case AuthQuery
    by contradiction /* from formulas */
  next
    case HonestTag
    by contradiction /* from formulas */
  qed
qed

lemma seed_birth_is_unique:
  all-traces
  "∀ n1 n2 key #i #j.
    ((SeedBorn( n1, key ) @ #i) ∧ (SeedBorn( n2, key ) @ #j)) ⇒
    ((n1 = n2) ∧ (#i = #j))"
/*
guarded formula characterizing all counter-examples:
"∃ n1 n2 key #i #j.
  (SeedBorn( n1, key ) @ #i) ∧ (SeedBorn( n2, key ) @ #j)
 ∧
  ((¬(n1 = n2)) ∨ (¬(#i = #j)))"
*/
simplify
solve( (¬(n1 = n2))  ∥ (¬(#i = #j)) )
  case case_1
  solve( SeedBorn( n1, key ) @ #i )
    case Anchor
    solve( !Master( s, master ) ▶₀ #i )
      case Source
      solve( SeedBorn( n2, ~key ) @ #j )
        case Anchor
        by contradiction /* from formulas */
      qed
    qed
  next
    case Grant
    solve( SeedBorn( n2, ~ck ) @ #j )
      case Grant
      by contradiction /* from formulas */
    qed
  next
    case Source
    solve( SeedBorn( n2, ~k ) @ #j )
      case Source
      by contradiction /* from formulas */
    qed
  next
    case Spend
    solve( SeedBorn( n2, ~ck ) @ #j )
      case Spend
      by contradiction /* from formulas */
    qed
  next
    case Split
    solve( !Bit( bit ) ▶₃ #i )
      case Source_case_1
      solve( SeedBorn( n2, ~ck ) @ #j )
        case Split
        by contradiction /* from formulas */
      qed
    next
      case Source_case_2
      solve( SeedBorn( n2, ~ck ) @ #j )
        case Split
        by contradiction /* from formulas */
      qed
    qed
  qed
next
  case case_2
  solve( (#i < #j)  ∥ (#j < #i) )
    case case_1
    solve( SeedBorn( n1, key ) @ #i )
      case Anchor
      solve( !Master( s, master ) ▶₀ #i )
        case Source
        solve( SeedBorn( n2, ~key ) @ #j )
          case Anchor
          by contradiction /* cyclic */
        qed
      qed
    next
      case Grant
      solve( SeedBorn( n2, ~ck ) @ #j )
        case Grant
        by contradiction /* cyclic */
      qed
    next
      case Source
      solve( SeedBorn( n2, ~k ) @ #j )
        case Source
        by contradiction /* cyclic */
      qed
    next
      case Spend
      solve( SeedBorn( n2, ~ck ) @ #j )
        case Spend
        by contradiction /* cyclic */
      qed
    next
      case Split
      solve( !Bit( bit ) ▶₃ #i )
        case Source_case_1
        solve( SeedBorn( n2, ~ck ) @ #j )
          case Split
          by contradiction /* cyclic */
        qed
      next
        case Source_case_2
        solve( SeedBorn( n2, ~ck ) @ #j )
          case Split
          by contradiction /* cyclic */
        qed
      qed
    qed
  next
    case case_2
    solve( SeedBorn( n1, key ) @ #i )
      case Anchor
      solve( !Master( s, master ) ▶₀ #i )
        case Source
        solve( SeedBorn( n2, ~key ) @ #j )
          case Anchor
          by contradiction /* cyclic */
        qed
      qed
    next
      case Grant
      solve( SeedBorn( n2, ~ck ) @ #j )
        case Grant
        by contradiction /* cyclic */
      qed
    next
      case Source
      solve( SeedBorn( n2, ~k ) @ #j )
        case Source
        by contradiction /* cyclic */
      qed
    next
      case Spend
      solve( SeedBorn( n2, ~ck ) @ #j )
        case Spend
        by contradiction /* cyclic */
      qed
    next
      case Split
      solve( !Bit( bit ) ▶₃ #i )
        case Source_case_1
        solve( SeedBorn( n2, ~ck ) @ #j )
          case Split
          by contradiction /* cyclic */
        qed
      next
        case Source_case_2
        solve( SeedBorn( n2, ~ck ) @ #j )
          case Split
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
qed

lemma grant_preserves_geometric_prefix:
  all-traces
  "∀ a n child gid p q #i.
    (GrantCreated( a, n, child, gid, p, q ) @ #i) ⇒ (p = q)"
/*
guarded formula characterizing all counter-examples:
"∃ a n child gid p q #i.
  (GrantCreated( a, n, child, gid, p, q ) @ #i) ∧ ¬(p = q)"
*/
simplify
by contradiction /* from formulas */

lemma two_grants_reachable:
  exists-trace
  "∃ a n1 n2 n3 g1 g2 p #i #j.
    ((GrantCreated( a, n1, n2, g1, p, p ) @ #i) ∧
     (GrantCreated( a, n2, n3, g2, p, p ) @ #j)) ∧
    (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ a n1 n2 n3 g1 g2 p #i #j.
  (GrantCreated( a, n1, n2, g1, p, p ) @ #i) ∧
  (GrantCreated( a, n2, n3, g2, p, p ) @ #j)
 ∧
  #i < #j"
*/
simplify
solve( !Node( s, a, n1, p, key )[-] ▶₀ #i )
  case Anchor
  solve( !Node( s.1, ~a, ~child, 'root', key.1 )[-] ▶₀ #j )
    case Grant
    SOLVED // trace found
  qed
qed

lemma leaked_parent_can_derive_child:
  exists-trace
  "∃ s a n child key label #r #q #k.
    ((((SeedRevealed( s, a, n, key ) @ #r) ∧
       (EdgeQueried( n, label, child ) @ #q)) ∧
      (#r < #q)) ∧
     (NodeKnown( s, a, child ) @ #k)) ∧
    (#q < #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ s a n child key label #r #q #k.
  (SeedRevealed( s, a, n, key ) @ #r) ∧
  (EdgeQueried( n, label, child ) @ #q) ∧
  (NodeKnown( s, a, child ) @ #k)
 ∧
  (#r < #q) ∧ (#q < #k)"
*/
simplify
solve( !Node( s, a, child, p, key.1 ) ▶₀ #k )
  case Grant
  solve( (∃ s a #r.
           (SeedRevealed( s, a, ~child, ~ck ) @ #r) ∧ #r < #vf.2)  ∥
         (∃ parent pk label #q #p.
           (EdgeDisclosed( parent, pk, label, ~child, ~ck ) @ #q) ∧ (K( pk ) @ #p)
          ∧
           (#p < #q) ∧ (#q < #vf.2)) )
    case case_1
    solve( SeedRevealed( s, a, n, key.2 ) @ #r )
      case RevealNode
      solve( !Node( s, a, n, p.1, key.1 ) ▶₀ #r )
        case Anchor
        solve( SeedRevealed( s.2, a.2, ~child, ~ck ) @ #r.1 )
          case RevealNode
          solve( !Node( s.1, a.1, ~child, p.1, ~ck ) ▶₀ #r.1 )
            case Grant
            solve( !Edge( ~a, label, ~child, key, ck.1 )[-] ▶₀ #q )
              case Grant
              solve( !KU( grant_label(gid) ) @ #vk.1 )
                case c_grant_label
                solve( !Node( ~s, ~a, ~a, p, key )[-] ▶₀ #vr )
                  case Anchor
                  solve( (∃ s a.1 #r.
                           (SeedRevealed( s, a.1, ~a, ~key ) @ #r) ∧ #r < #vf)  ∥
                         (∃ parent pk label #q #p.
                           (EdgeDisclosed( parent, pk, label, ~a, ~key ) @ #q) ∧ (K( pk ) @ #p)
                          ∧
                           (#p < #q) ∧ (#q < #vf)) )
                    case case_1
                    solve( SeedRevealed( s.1, a.1, ~a, ~key ) @ #r.2 )
                      case RevealNode
                      solve( !Node( s.1, a.1, ~a, p, ~key ) ▶₀ #r.2 )
                        case Anchor
                        solve( !KU( ~key )[+] @ #vk.1 )
                          case RevealNode
                          solve( !KU( ~ck ) @ #vk.2 )
                            case RevealNode
                            SOLVED // trace found
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma grant_output_requires_parent_or_direct_exposure:
  all-traces
  "∀ parent pk gid child ck #g #k.
    ((GrantSeed( parent, pk, gid, child, ck ) @ #g) ∧ (K( ck ) @ #k)) ⇒
    ((∃ s a #r. (SeedRevealed( s, a, child, ck ) @ #r) ∧ (#r < #k)) ∨
     (∃ #p. (K( pk ) @ #p) ∧ (#p < #k)))"
/*
guarded formula characterizing all counter-examples:
"∃ parent pk gid child ck #g #k.
  (GrantSeed( parent, pk, gid, child, ck ) @ #g) ∧ (K( ck ) @ #k)
 ∧
  (∀ s a #r. (SeedRevealed( s, a, child, ck ) @ #r) ⇒ ¬(#r < #k)) ∧
  (∀ #p. (K( pk ) @ #p) ⇒ ¬(#p < #k))"
*/
simplify
solve( (∃ s a #r. (SeedRevealed( s, a, ~child, ~ck ) @ #r) ∧ #r < #k)  ∥
       (∃ parent pk label #q #p.
         (EdgeDisclosed( parent, pk, label, ~child, ~ck ) @ #q) ∧ (K( pk ) @ #p)
        ∧
         (#p < #q) ∧ (#q < #k)) )
  case case_1
  by contradiction /* from formulas */
next
  case case_2
  solve( !Edge( parent.1, label, ~child, pk.1, ~ck )[-] ▶₀ #q )
    case Grant
    by contradiction /* from formulas */
  qed
qed

lemma sibling_grants_have_distinct_ideal_seeds:
  all-traces
  "∀ parent pk gid1 gid2 c1 c2 k1 k2 #i #j.
    (((GrantSeed( parent, pk, gid1, c1, k1 ) @ #i) ∧
      (GrantSeed( parent, pk, gid2, c2, k2 ) @ #j)) ∧
     (¬(gid1 = gid2))) ⇒
    (¬(k1 = k2))"
/*
guarded formula characterizing all counter-examples:
"∃ parent pk gid1 gid2 c1 c2 k1 k2 #i #j.
  (GrantSeed( parent, pk, gid1, c1, k1 ) @ #i) ∧
  (GrantSeed( parent, pk, gid2, c2, k2 ) @ #j)
 ∧
  (¬(gid1 = gid2)) ∧ (k1 = k2)"
*/
simplify
by contradiction /* from formulas */

lemma old_child_disclosure_then_new_sibling_reachable:
  exists-trace
  "∃ s a parent pk oldid newid oldchild newchild oldkey newkey #g #r #n.
    (((((GrantSeed( parent, pk, oldid, oldchild, oldkey ) @ #g) ∧
        (SeedRevealed( s, a, oldchild, oldkey ) @ #r)) ∧
       (GrantSeed( parent, pk, newid, newchild, newkey ) @ #n)) ∧
      (#g < #r)) ∧
     (#r < #n)) ∧
    (¬(oldid = newid))"
/*
guarded formula characterizing all satisfying traces:
"∃ s a parent pk oldid newid oldchild newchild oldkey newkey #g #r #n.
  (GrantSeed( parent, pk, oldid, oldchild, oldkey ) @ #g) ∧
  (SeedRevealed( s, a, oldchild, oldkey ) @ #r) ∧
  (GrantSeed( parent, pk, newid, newchild, newkey ) @ #n)
 ∧
  (#g < #r) ∧ (#r < #n) ∧ (¬(oldid = newid))"
*/
simplify
solve( SeedRevealed( s.2, a.2, ~child, ~ck ) @ #r )
  case RevealNode
  solve( !Node( s.2, a.2, ~child, p.2, ~ck ) ▶₀ #r )
    case Grant
    solve( !Node( s, a, parent, p, pk )[-] ▶₀ #g )
      case Anchor
      solve( !Node( s.1, a.1, ~a, p, ~key )[-] ▶₀ #n )
        case Anchor
        SOLVED // trace found
      qed
    qed
  qed
qed

/* All wellformedness checks were successful. */

