theory SACReDCredentialAuthentication

begin

// Function signature and definition of the equational theory E

functions: channel_packet/2[private,constructor], fst/1, mac/2, pair/2,
           pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

rule (modulo E) Agent:
   [ Fr( ~agent ), Fr( ~key ) ]
  --[ AgentCreated( ~agent, ~key ) ]->
   [
   !Agent( ~agent, ~key ), !PublicKey( ~agent, pk(~key) ),
   Out( <~agent, pk(~key)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromiseAgent:
   [ !Agent( agent, key ) ]
  --[ AgentCompromised( agent, key ) ]->
   [ !Compromised( agent ), Out( key ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ContextInterface:
   [ Fr( ~ctx ), In( endpoint ) ]
  -->
   [ !Context( ~ctx, endpoint ), Out( <~ctx, endpoint> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ImportRegisteredRight:
   [ !Context( ctx, endpoint ), !Agent( holder, key ), Fr( ~d ), In( side )
   ]
  --[ RightRegistered( ~d, ~d, ctx, endpoint, side, holder ) ]->
   [ !Right( ~d, ~d, ctx, endpoint, side, holder, pk(key) ), Out( ~d ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) IssueACT:
   [
   !Right( dc, rc, ctx, endpoint, 'caller', caller, callerpk )[-],
   !Right( ds, rs, ctx, endpoint, 'service', service, pk(key) )[-],
   !Agent( service, key ), Fr( ~sid ), In( expiry )
   ]
  --[
  ACTIssued( service, <'act', caller, service, dc, ds, ctx, ~sid, expiry> )
  ]->
   [
   Out( <<'act', caller, service, dc, ds, ctx, ~sid, expiry>, 
         sign(<'act', caller, service, dc, ds, ctx, ~sid, expiry>, key)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) RequestCredential:
   [
   !Right( dc, root, ctx, endpoint, 'caller', caller, callerpk )[-],
   Fr( ~keyid ), Fr( ~secret )
   ]
  --[ RequestKeyCreated( ~keyid, caller, ~secret ) ]->
   [ !RequestKey( ~keyid, caller, ~secret ), Out( ~keyid ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromisedCredentialDelivery:
   [ !Compromised( caller ), !RequestKey( keyid, caller, secret ) ]
  --[ RequestKeyRevealed( keyid, caller, secret ) ]->
   [ Out( secret ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) RevealCredential:
   [ !RequestKey( keyid, caller, secret ) ]
  --[ RequestKeyRevealed( keyid, caller, secret ) ]->
   [ Out( secret ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) GenerateTag:
   [ !RequestKey( keyid, caller, secret ), In( message ) ]
  --[ TagGenerated( keyid, caller, message ) ]->
   [ Out( mac(secret, message) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) HonestChannelSend:
   [ !Agent( caller, key ), In( message ) ]
  --[ ChannelSent( caller, message ) ]->
   [ Out( <message, channel_packet(pk(key), message)> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SendWithKnownIdentityKey:
   [ !PublicKey( caller, pk(key) ), In( key ), In( message ) ]
  --[ ChannelSentWithExposedKey( caller, message ) ]->
   [ Out( <message, channel_packet(pk(key), message)> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) RevealSession:
   [ !PublicKey( caller, pubkey ), In( <service, ctx, sid> ) ]
  --[ SessionExposed( caller, service, ctx, sid ) ]->
   [ !ExposedSession( caller, service, ctx, sid ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SendOnExposedSession:
   [
   !ExposedSession( caller, service, ctx, sid ),
   !PublicKey( caller, pubkey ),
   In( <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
        vector>
   )
   ]
  --[
  ChannelSentWithExposedSession( caller, service, ctx, sid,
                                 <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                                  vector>
  )
  ]->
   [
   Out( <
         <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
          vector>, 
         channel_packet(pubkey,
                        <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                         vector>)
        >
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CheckACT:
   [
   !PublicKey( service, pubkey ),
   In( <<'act', caller, service, dc, ds, ctx, sid, expiry>, sig> )
   ]
  --[
  Eq( verify(sig, <'act', caller, service, dc, ds, ctx, sid, expiry>,
             pubkey),
      true
  ),
  ACTChecked( service, <'act', caller, service, dc, ds, ctx, sid, expiry> )
  ]->
   [
   !VerifiedACT( service, <'act', caller, service, dc, ds, ctx, sid, expiry>
   )
   ]

  /*
  rule (modulo AC) CheckACT:
     [
     !PublicKey( service, pubkey ),
     In( <<'act', caller, service, dc, ds, ctx, sid, expiry>, sig> )
     ]
    --[
    Eq( z, true ),
    ACTChecked( service, <'act', caller, service, dc, ds, ctx, sid, expiry> )
    ]->
     [
     !VerifiedACT( service, <'act', caller, service, dc, ds, ctx, sid, expiry>
     )
     ]
    variants (modulo AC)
    1. caller
             = caller.13
       ctx   = ctx.14
       dc    = dc.15
       ds    = ds.16
       expiry
             = expiry.17
       pubkey
             = pubkey.18
       service
             = service.19
       sid   = sid.20
       sig   = sig.21
       z     = verify(sig.21,
                      <'act', caller.13, service.19, dc.15, ds.16, ctx.14, sid.20, expiry.17>,
                      pubkey.18)
    
    2. caller
             = caller.20
       ctx   = ctx.21
       dc    = dc.22
       ds    = ds.23
       expiry
             = expiry.24
       pubkey
             = pk(x.36)
       service
             = service.26
       sid   = sid.27
       sig   = sign(<'act', caller.20, service.26, dc.22, ds.23, ctx.21, 
                     sid.27, expiry.24>,
                    x.36)
       z     = true
  */

rule (modulo E) CheckChannel:
   [
   !PublicKey( caller, callerpk ),
   In( <message, channel_packet(callerpk, message)> )
   ]
  --[ ChannelChecked( caller, message ) ]->
   [ !VerifiedChannel( caller, message ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CheckTag:
   [
   !RequestKey( keyid, caller, secret ),
   In( <message, mac(secret, message)> )
   ]
  --[ TagChecked( keyid, caller, message ) ]->
   [ !VerifiedTag( keyid, caller, message ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) VerifyRequest:
   [
   !Right( dc, rc, ctx, endpoint, 'caller', caller, callerpk ),
   !Right( ds, rs, ctx, endpoint, 'service', service, servicepk ),
   !VerifiedACT( service, <'act', caller, service, dc, ds, ctx, sid, expiry>
   ),
   !VerifiedChannel( caller,
                     <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                      vector>
   ),
   !VerifiedTag( keyid, caller,
                 <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                  vector>
   )
   ]
  --[
  BilateralChecked( dc, ds, ctx, endpoint, caller, service ),
  CryptoVerified( caller, service, dc, ds, ctx, endpoint, sid, keyid,
                  <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                   vector>
  )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

lemma identity_knowledge_requires_compromise [reuse]:
  all-traces
  "∀ agent key #c #k.
    ((AgentCreated( agent, key ) @ #c) ∧ (K( key ) @ #k)) ⇒
    (∃ #r. (AgentCompromised( agent, key ) @ #r) ∧ (#r < #k))"
/*
guarded formula characterizing all counter-examples:
"∃ agent key #c #k.
  (AgentCreated( agent, key ) @ #c) ∧ (K( key ) @ #k)
 ∧
  ∀ #r. (AgentCompromised( agent, key ) @ #r) ⇒ ¬(#r < #k)"
*/
simplify
solve( !KU( ~key ) @ #vk )
  case CompromiseAgent
  by contradiction /* from formulas */
qed

lemma request_secret_requires_exposure [reuse]:
  all-traces
  "∀ keyid caller secret #c #k.
    ((RequestKeyCreated( keyid, caller, secret ) @ #c) ∧
     (K( secret ) @ #k)) ⇒
    (∃ #r. (RequestKeyRevealed( keyid, caller, secret ) @ #r) ∧ (#r < #k))"
/*
guarded formula characterizing all counter-examples:
"∃ keyid caller secret #c #k.
  (RequestKeyCreated( keyid, caller, secret ) @ #c) ∧ (K( secret ) @ #k)
 ∧
  ∀ #r. (RequestKeyRevealed( keyid, caller, secret ) @ #r) ⇒ ¬(#r < #k)"
*/
simplify
solve( !KU( ~secret ) @ #vk )
  case CompromisedCredentialDelivery
  by contradiction /* from formulas */
next
  case RevealCredential
  by contradiction /* from formulas */
qed

lemma act_origin_or_service_compromise:
  all-traces
  "∀ service token #r.
    (ACTChecked( service, token ) @ #r) ⇒
    ((∃ #s. (ACTIssued( service, token ) @ #s) ∧ (#s < #r)) ∨
     (∃ key #c. (AgentCompromised( service, key ) @ #c) ∧ (#c < #r)))"
/*
guarded formula characterizing all counter-examples:
"∃ service token #r.
  (ACTChecked( service, token ) @ #r)
 ∧
  (∀ #s. (ACTIssued( service, token ) @ #s) ⇒ ¬(#s < #r)) ∧
  (∀ key #c. (AgentCompromised( service, key ) @ #c) ⇒ ¬(#c < #r))"
*/
simplify
solve( !PublicKey( service, pk(x) ) ▶₀ #r )
  case Agent
  solve( !KU( sign(<'act', caller, ~agent, dc, ds, ctx, sid, expiry>, ~key)
         ) @ #vk.16 )
    case IssueACT
    by contradiction /* from formulas */
  next
    case c_sign
    solve( !KU( ~key ) @ #vk.17 )
      case CompromiseAgent
      by contradiction /* from formulas */
    qed
  qed
qed

lemma authenticated_message_origin_or_identity_or_session_exposure:
  all-traces
  "∀ caller service ctx sid rho dc ds action payload vector #r.
    (ChannelChecked( caller,
                     <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                      vector>
     ) @ #r) ⇒
    (((∃ #s.
        (ChannelSent( caller,
                      <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                       vector>
         ) @ #s) ∧
        (#s < #r)) ∨
      (∃ key #c. (AgentCompromised( caller, key ) @ #c) ∧ (#c < #r))) ∨
     (∃ #c. (SessionExposed( caller, service, ctx, sid ) @ #c) ∧ (#c < #r)))"
/*
guarded formula characterizing all counter-examples:
"∃ caller service ctx sid rho dc ds action payload vector #r.
  (ChannelChecked( caller,
                   <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                    vector>
   ) @ #r)
 ∧
  (∀ #s.
    (ChannelSent( caller,
                  <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                   vector>
     ) @ #s)
   ⇒
    ¬(#s < #r)) ∧
  (∀ key #c. (AgentCompromised( caller, key ) @ #c) ⇒ ¬(#c < #r)) ∧
  (∀ #c. (SessionExposed( caller, service, ctx, sid ) @ #c) ⇒ ¬(#c < #r))"
*/
simplify
solve( !PublicKey( caller, callerpk ) ▶₀ #r )
  case Agent
  solve( !KU( channel_packet(pk(~key),
                             <'request', rho, ctx, sid, ~agent, service, dc, ds, action, payload, 
                              vector>)
         ) @ #vk.2 )
    case HonestChannelSend
    by contradiction /* from formulas */
  next
    case SendOnExposedSession
    by contradiction /* from formulas */
  next
    case SendWithKnownIdentityKey
    by contradiction /* from formulas */
  qed
qed

lemma complete_message_tag_origin_or_secret_exposure:
  all-traces
  "∀ keyid caller message #r.
    (TagChecked( keyid, caller, message ) @ #r) ⇒
    ((∃ #s. (TagGenerated( keyid, caller, message ) @ #s) ∧ (#s < #r)) ∨
     (∃ secret #c.
       (RequestKeyRevealed( keyid, caller, secret ) @ #c) ∧ (#c < #r)))"
/*
guarded formula characterizing all counter-examples:
"∃ keyid caller message #r.
  (TagChecked( keyid, caller, message ) @ #r)
 ∧
  (∀ #s. (TagGenerated( keyid, caller, message ) @ #s) ⇒ ¬(#s < #r)) ∧
  (∀ secret #c.
    (RequestKeyRevealed( keyid, caller, secret ) @ #c) ⇒ ¬(#c < #r))"
*/
simplify
solve( !RequestKey( keyid, caller, secret ) ▶₀ #r )
  case RequestCredential
  solve( !KU( mac(~secret, message) ) @ #vk.2 )
    case GenerateTag
    by contradiction /* from formulas */
  next
    case c_mac
    solve( !KU( ~secret ) @ #vk.5 )
      case CompromisedCredentialDelivery
      by contradiction /* from formulas */
    next
      case RevealCredential
      by contradiction /* from formulas */
    qed
  qed
qed

lemma verified_request_has_both_registered_sides:
  all-traces
  "∀ dc ds ctx endpoint caller service #r.
    (BilateralChecked( dc, ds, ctx, endpoint, caller, service ) @ #r) ⇒
    (∃ rc rs #c #s.
      (((RightRegistered( dc, rc, ctx, endpoint, 'caller', caller ) @ #c) ∧
        (RightRegistered( ds, rs, ctx, endpoint, 'service', service ) @ #s)) ∧
       (#c < #r)) ∧
      (#s < #r))"
/*
guarded formula characterizing all counter-examples:
"∃ dc ds ctx endpoint caller service #r.
  (BilateralChecked( dc, ds, ctx, endpoint, caller, service ) @ #r)
 ∧
  ∀ rc rs #c #s.
   (RightRegistered( dc, rc, ctx, endpoint, 'caller', caller ) @ #c) ∧
   (RightRegistered( ds, rs, ctx, endpoint, 'service', service ) @ #s)
  ⇒
   ((¬(#c < #r)) ∨ (¬(#s < #r)))"
*/
simplify
solve( !Right( dc, rc, ctx, endpoint, 'caller', caller, callerpk
       ) ▶₀ #r )
  case ImportRegisteredRight
  solve( !Right( ds, rs, ~ctx, endpoint, 'service', service, servicepk
         ) ▶₁ #r )
    case ImportRegisteredRight
    by contradiction /* from formulas */
  qed
qed

lemma verified_request_has_three_matching_checks:
  all-traces
  "∀ caller service dc ds ctx endpoint sid keyid rho action payload vector
     #r.
    (CryptoVerified( caller, service, dc, ds, ctx, endpoint, sid, keyid,
                     <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                      vector>
     ) @ #r) ⇒
    (∃ expiry #a #c #t.
      (((((ACTChecked( service,
                       <'act', caller, service, dc, ds, ctx, sid, expiry>
           ) @ #a) ∧
          (ChannelChecked( caller,
                           <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                            vector>
           ) @ #c)) ∧
         (TagChecked( keyid, caller,
                      <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                       vector>
          ) @ #t)) ∧
        (#a < #r)) ∧
       (#c < #r)) ∧
      (#t < #r))"
/*
guarded formula characterizing all counter-examples:
"∃ caller service dc ds ctx endpoint sid keyid rho action payload vector
   #r.
  (CryptoVerified( caller, service, dc, ds, ctx, endpoint, sid, keyid,
                   <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                    vector>
   ) @ #r)
 ∧
  ∀ expiry #a #c #t.
   (ACTChecked( service, <'act', caller, service, dc, ds, ctx, sid, expiry>
    ) @ #a) ∧
   (ChannelChecked( caller,
                    <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                     vector>
    ) @ #c) ∧
   (TagChecked( keyid, caller,
                <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                 vector>
    ) @ #t)
  ⇒
   ((¬(#a < #r)) ∨ (¬(#c < #r)) ∨ (¬(#t < #r)))"
*/
simplify
solve( !Right( dc, rc, ctx, endpoint, 'caller', caller, callerpk
       ) ▶₀ #r )
  case ImportRegisteredRight
  solve( !Right( ds, rs, ~ctx, endpoint, 'service', service, servicepk
         ) ▶₁ #r )
    case ImportRegisteredRight
    solve( !VerifiedACT( ~agent.1,
                         <'act', ~agent, ~agent.1, ~d, ~d.1, ~ctx, sid, expiry>
           ) ▶₂ #r )
      case CheckACT
      solve( !VerifiedChannel( ~agent,
                               <'request', rho, ~ctx, sid, ~agent, ~agent.1, ~d, ~d.1, action, payload, 
                                vector>
             ) ▶₃ #r )
        case CheckChannel_case_1
        solve( !VerifiedTag( keyid, ~agent,
                             <'request', rho, ~ctx, sid, ~agent, ~agent.1, ~d, ~d.1, action, payload, 
                              vector>
               ) ▶₄ #r )
          case CheckTag
          by contradiction /* from formulas */
        qed
      next
        case CheckChannel_case_2
        solve( !VerifiedTag( keyid, ~agent,
                             <'request', rho, ~ctx, sid, ~agent, ~agent.1, ~d, ~d.1, action, payload, 
                              vector>
               ) ▶₄ #r )
          case CheckTag
          by contradiction /* from formulas */
        qed
      next
        case CheckChannel_case_3
        solve( !VerifiedTag( keyid, ~agent,
                             <'request', rho, ~ctx, sid, ~agent, ~agent.1, ~d, ~d.1, action, payload, 
                              vector>
               ) ▶₄ #r )
          case CheckTag
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
qed

lemma distinct_bilateral_request_exists:
  exists-trace
  "∃ caller service dc ds ctx endpoint sid keyid message #r.
    (((((CryptoVerified( caller, service, dc, ds, ctx, endpoint, sid, keyid,
                         message
         ) @ #r) ∧
        (¬(caller = service))) ∧
       (¬(dc = ds))) ∧
      (¬(∃ who key #c. AgentCompromised( who, key ) @ #c))) ∧
     (¬(∃ id who secret #c. RequestKeyRevealed( id, who, secret ) @ #c))) ∧
    (¬(∃ who peer coll sess #c.
        SessionExposed( who, peer, coll, sess ) @ #c))"
/*
guarded formula characterizing all satisfying traces:
"∃ caller service dc ds ctx endpoint sid keyid message #r.
  (CryptoVerified( caller, service, dc, ds, ctx, endpoint, sid, keyid,
                   message
   ) @ #r)
 ∧
  (¬(caller = service)) ∧
  (¬(dc = ds)) ∧
  (∀ who key #c. (AgentCompromised( who, key ) @ #c) ⇒ ⊥) ∧
  (∀ id who secret #c. (RequestKeyRevealed( id, who, secret ) @ #c) ⇒ ⊥) ∧
  (∀ who peer coll sess #c.
    (SessionExposed( who, peer, coll, sess ) @ #c) ⇒ ⊥)"
*/
simplify
solve( !Right( dc, rc, ctx, endpoint, 'caller', caller, callerpk
       ) ▶₀ #r )
  case ImportRegisteredRight
  solve( !Right( ds, rs, ~ctx, endpoint, 'service', service, servicepk
         ) ▶₁ #r )
    case ImportRegisteredRight
    solve( !VerifiedACT( ~agent.1,
                         <'act', ~agent, ~agent.1, ~d, ~d.1, ~ctx, sid, expiry>
           ) ▶₂ #r )
      case CheckACT
      solve( !VerifiedChannel( ~agent,
                               <'request', rho, ~ctx, sid, ~agent, ~agent.1, ~d, ~d.1, action, payload, 
                                vector>
             ) ▶₃ #r )
        case CheckChannel_case_1
        solve( !VerifiedTag( keyid, ~agent,
                             <'request', rho, ~ctx, sid, ~agent, ~agent.1, ~d, ~d.1, action, payload, 
                              vector>
               ) ▶₄ #r )
          case CheckTag
          solve( !KU( sign(<'act', ~agent, ~agent.1, ~d, ~d.1, ~ctx, sid, expiry>,
                           ~key.1)
                 ) @ #vk.28 )
            case IssueACT
            solve( !KU( mac(~secret,
                            <'request', rho, ~ctx, ~sid, ~agent, ~agent.1, ~d, ~d.1, action, 
                             payload, vector>)
                   ) @ #vk.38 )
              case GenerateTag
              solve( !KU( ~agent ) @ #vk.11 )
                case Agent
                solve( !KU( ~agent.1 ) @ #vk.19 )
                  case Agent
                  solve( !KU( ~d ) @ #vk.22 )
                    case ImportRegisteredRight
                    solve( !KU( ~d.1 ) @ #vk.25 )
                      case ImportRegisteredRight
                      solve( !KU( ~ctx ) @ #vk.28 )
                        case ContextInterface
                        solve( !KU( ~sid ) @ #vk.30 )
                          case IssueACT
                          SOLVED // trace found
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma compromised_caller_can_make_verified_request:
  exists-trace
  "∃ caller key service dc ds ctx endpoint sid keyid message #c #r.
    (((AgentCompromised( caller, key ) @ #c) ∧
      (CryptoVerified( caller, service, dc, ds, ctx, endpoint, sid, keyid,
                       message
       ) @ #r)) ∧
     (#c < #r)) ∧
    (¬(caller = service))"
/*
guarded formula characterizing all satisfying traces:
"∃ caller key service dc ds ctx endpoint sid keyid message #c #r.
  (AgentCompromised( caller, key ) @ #c) ∧
  (CryptoVerified( caller, service, dc, ds, ctx, endpoint, sid, keyid,
                   message
   ) @ #r)
 ∧
  (#c < #r) ∧ (¬(caller = service))"
*/
simplify
solve( !Agent( caller, key ) ▶₀ #c )
  case Agent
  solve( !Right( dc, rc, ctx, endpoint, 'caller', ~agent, callerpk
         ) ▶₀ #r )
    case ImportRegisteredRight
    solve( !Right( ds, rs, ~ctx, endpoint, 'service', service, servicepk
           ) ▶₁ #r )
      case ImportRegisteredRight
      solve( !VerifiedACT( ~agent.1,
                           <'act', ~agent, ~agent.1, ~d, ~d.1, ~ctx, sid, expiry>
             ) ▶₂ #r )
        case CheckACT
        solve( !VerifiedChannel( ~agent,
                                 <'request', rho, ~ctx, sid, ~agent, ~agent.1, ~d, ~d.1, action, payload, 
                                  vector>
               ) ▶₃ #r )
          case CheckChannel_case_1
          solve( !VerifiedTag( keyid, ~agent,
                               <'request', rho, ~ctx, sid, ~agent, ~agent.1, ~d, ~d.1, action, payload, 
                                vector>
                 ) ▶₄ #r )
            case CheckTag
            solve( !KU( sign(<'act', ~agent, ~agent.1, ~d, ~d.1, ~ctx, sid, expiry>,
                             ~key.1)
                   ) @ #vk.28 )
              case IssueACT
              solve( !KU( mac(~secret,
                              <'request', rho, ~ctx, ~sid, ~agent, ~agent.1, ~d, ~d.1, action, 
                               payload, vector>)
                     ) @ #vk.38 )
                case GenerateTag
                solve( !KU( ~agent ) @ #vk.11 )
                  case Agent
                  solve( !KU( ~agent.1 ) @ #vk.19 )
                    case Agent
                    solve( !KU( ~d ) @ #vk.22 )
                      case ImportRegisteredRight
                      solve( !KU( ~d.1 ) @ #vk.25 )
                        case ImportRegisteredRight
                        solve( !KU( ~ctx ) @ #vk.28 )
                          case ContextInterface
                          solve( !KU( ~sid ) @ #vk.30 )
                            case IssueACT
                            SOLVED // trace found
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma same_session_two_fresh_request_credentials:
  exists-trace
  "∃ caller service dc ds ctx endpoint sid k1 k2 m1 m2 #r1 #r2.
    ((((((((CryptoVerified( caller, service, dc, ds, ctx, endpoint, sid, k1,
                            m1
            ) @ #r1) ∧
           (CryptoVerified( caller, service, dc, ds, ctx, endpoint, sid, k2, m2
            ) @ #r2)) ∧
          (#r1 < #r2)) ∧
         (¬(k1 = k2))) ∧
        (¬(m1 = m2))) ∧
       (¬(caller = service))) ∧
      (¬(∃ who key #c. AgentCompromised( who, key ) @ #c))) ∧
     (¬(∃ id who secret #c. RequestKeyRevealed( id, who, secret ) @ #c))) ∧
    (¬(∃ who peer coll sess #c.
        SessionExposed( who, peer, coll, sess ) @ #c))"
/*
guarded formula characterizing all satisfying traces:
"∃ caller service dc ds ctx endpoint sid k1 k2 m1 m2 #r1 #r2.
  (CryptoVerified( caller, service, dc, ds, ctx, endpoint, sid, k1, m1
   ) @ #r1) ∧
  (CryptoVerified( caller, service, dc, ds, ctx, endpoint, sid, k2, m2
   ) @ #r2)
 ∧
  (#r1 < #r2) ∧
  (¬(k1 = k2)) ∧
  (¬(m1 = m2)) ∧
  (¬(caller = service)) ∧
  (∀ who key #c. (AgentCompromised( who, key ) @ #c) ⇒ ⊥) ∧
  (∀ id who secret #c. (RequestKeyRevealed( id, who, secret ) @ #c) ⇒ ⊥) ∧
  (∀ who peer coll sess #c.
    (SessionExposed( who, peer, coll, sess ) @ #c) ⇒ ⊥)"
*/
simplify
solve( !Right( dc, rc, ctx, endpoint, 'caller', caller, callerpk
       ) ▶₀ #r1 )
  case ImportRegisteredRight
  solve( !Right( ds, rs, ~ctx, endpoint, 'service', service, servicepk
         ) ▶₁ #r1 )
    case ImportRegisteredRight
    solve( !VerifiedACT( ~agent.1,
                         <'act', ~agent, ~agent.1, ~d, ~d.1, ~ctx, sid, expiry>
           ) ▶₂ #r1 )
      case CheckACT
      solve( !VerifiedChannel( ~agent,
                               <'request', rho, ~ctx, sid, ~agent, ~agent.1, ~d, ~d.1, action, payload, 
                                vector>
             ) ▶₃ #r1 )
        case CheckChannel_case_1
        solve( !VerifiedTag( k1, ~agent,
                             <'request', rho, ~ctx, sid, ~agent, ~agent.1, ~d, ~d.1, action, payload, 
                              vector>
               ) ▶₄ #r1 )
          case CheckTag
          solve( !Right( ~d, rc, ~ctx, endpoint, 'caller', ~agent, callerpk
                 ) ▶₀ #r2 )
            case ImportRegisteredRight
            solve( !Right( ~d.1, rs, ~ctx, endpoint, 'service', ~agent.1, servicepk
                   ) ▶₁ #r2 )
              case ImportRegisteredRight
              solve( !VerifiedACT( ~agent.1,
                                   <'act', ~agent, ~agent.1, ~d, ~d.1, ~ctx, sid, expiry.1>
                     ) ▶₂ #r2 )
                case CheckACT
                solve( !VerifiedChannel( ~agent,
                                         <'request', rho.1, ~ctx, sid, ~agent, ~agent.1, ~d, ~d.1, action.1, 
                                          payload.1, vector.1>
                       ) ▶₃ #r2 )
                  case CheckChannel_case_1
                  solve( !VerifiedTag( k2, ~agent,
                                       <'request', rho.1, ~ctx, sid, ~agent, ~agent.1, ~d, ~d.1, action.1, 
                                        payload.1, vector.1>
                         ) ▶₄ #r2 )
                    case CheckTag
                    solve( !KU( sign(<'act', ~agent, ~agent.1, ~d, ~d.1, ~ctx, sid, expiry>,
                                     ~key.1)
                           ) @ #vk.47 )
                      case IssueACT
                      solve( !KU( sign(<'act', ~agent, ~agent.1, ~d, ~d.1, ~ctx, ~sid, expiry.1
                                       >,
                                       ~key.1)
                             ) @ #vk.60 )
                        case IssueACT
                        solve( !KU( mac(~secret,
                                        <'request', rho, ~ctx, ~sid, ~agent, ~agent.1, ~d, ~d.1, action, 
                                         payload, vector>)
                               ) @ #vk.49 )
                          case GenerateTag
                          solve( !KU( mac(~secret.1,
                                          <'request', rho.1, ~ctx, ~sid, ~agent, ~agent.1, ~d, ~d.1, 
                                           action.1, payload.1, vector.1>)
                                 ) @ #vk.57 )
                            case GenerateTag
                            solve( !KU( ~agent ) @ #vk.15 )
                              case Agent
                              solve( !KU( ~agent.1 ) @ #vk.28 )
                                case Agent
                                solve( !KU( ~d ) @ #vk.32 )
                                  case ImportRegisteredRight
                                  solve( !KU( ~d.1 ) @ #vk.36 )
                                    case ImportRegisteredRight
                                    solve( !KU( ~ctx ) @ #vk.40 )
                                      case ContextInterface
                                      solve( !KU( ~sid ) @ #vk.42 )
                                        case IssueACT
                                        SOLVED // trace found
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma session_leak_can_impersonate_without_identity_leak:
  exists-trace
  "∃ caller service ctx sid rho dc ds action payload vector #e #c.
    ((((SessionExposed( caller, service, ctx, sid ) @ #e) ∧
       (ChannelChecked( caller,
                        <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                         vector>
        ) @ #c)) ∧
      (#e < #c)) ∧
     (¬(∃ #s.
         ChannelSent( caller,
                      <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                       vector>
         ) @ #s))) ∧
    (¬(∃ who key #r. AgentCompromised( who, key ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ caller service ctx sid rho dc ds action payload vector #e #c.
  (SessionExposed( caller, service, ctx, sid ) @ #e) ∧
  (ChannelChecked( caller,
                   <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                    vector>
   ) @ #c)
 ∧
  (#e < #c) ∧
  (∀ #s.
    (ChannelSent( caller,
                  <'request', rho, ctx, sid, caller, service, dc, ds, action, payload, 
                   vector>
     ) @ #s)
   ⇒
    ⊥) ∧
  (∀ who key #r. (AgentCompromised( who, key ) @ #r) ⇒ ⊥)"
*/
simplify
solve( !PublicKey( caller, pubkey ) ▶₀ #e )
  case Agent
  solve( !PublicKey( ~agent, callerpk ) ▶₀ #c )
    case Agent
    solve( !KU( channel_packet(pk(~key),
                               <'request', rho, ctx, sid, ~agent, service, dc, ds, action, payload, 
                                vector>)
           ) @ #vk.12 )
      case SendOnExposedSession
      solve( !KU( ~agent ) @ #vk.15 )
        case Agent
        SOLVED // trace found
      qed
    qed
  qed
qed

