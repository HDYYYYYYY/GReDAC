theory SACReDControlAuthentication
begin
builtins: signing
// Generic exact-byte signature module. Signing queries are unrestricted;
// origin is not a statement that the signed message is policy-eligible.
// ProtectedIssuer denotes a protected user/Authority signing key.
rule ProtectedIssuer:
 [ Fr(~issuer), Fr(~key), In(role) ]
 --[ ProtectedKey(~issuer,role,~key) ]->
 [ !Protected(~issuer,role,~key), !ProtectedPublic(~issuer,role,pk(~key)),
   Out(<~issuer,role,pk(~key)>) ]
rule ProtectedSign:
 [ !Protected(issuer,role,key), In(message) ]
 --[ ProtectedSigned(issuer,role,message) ]->
 [ Out(<message,sign(message,key)>) ]
rule ProtectedCheck:
 [ !ProtectedPublic(issuer,role,pubkey), In(<message,sig>) ]
 --[ Eq(verify(sig,message,pubkey),true), ProtectedChecked(issuer,role,message) ]-> []
rule Agent:
 [ Fr(~agent), Fr(~key) ]
 --[ AgentCreated(~agent,~key) ]->
 [ !Agent(~agent,~key), !PublicKey(~agent,pk(~key)),
   Out(<~agent,pk(~key)>) ]

rule CompromiseAgent:
 [ !Agent(agent,key) ]
 --[ AgentCompromised(agent,key) ]->
 [ !Compromised(agent), Out(key) ]


rule AgentSign:
 [ !Agent(signer,key), In(message) ]
 --[ AgentSigned(signer,message) ]-> [ Out(<message,sign(message,key)>) ]
rule AgentCheck:
 [ !PublicKey(signer,pubkey), In(<message,sig>) ]
 --[ Eq(verify(sig,message,pubkey),true), AgentChecked(signer,message) ]-> []
restriction Equality:
 "All x y #i. Eq(x,y)@i ==> x = y"
lemma protected_key_secret [reuse]:
 "All issuer role key #g #k. ProtectedKey(issuer,role,key)@g & K(key)@k ==> F"
lemma identity_knowledge_requires_compromise [reuse]:
 "All agent key #c #k. AgentCreated(agent,key)@c & K(key)@k
  ==> (Ex #r. AgentCompromised(agent,key)@r & r < k)"


lemma protected_signature_origin:
 "All issuer role message #c. ProtectedChecked(issuer,role,message)@c
 ==> (Ex #s. ProtectedSigned(issuer,role,message)@s & s < c)"
lemma agent_signature_origin_or_compromise:
 "All signer message #c. AgentChecked(signer,message)@c
 ==> (Ex #s. AgentSigned(signer,message)@s & s < c)
 | (Ex key #r. AgentCompromised(signer,key)@r & r < c)"
lemma exposed_signer_can_forge_without_honest_issue:
 exists-trace
 "Ex signer key message #r #c. AgentCompromised(signer,key)@r
 & AgentChecked(signer,message)@c & r < c
 & not(Ex #s. AgentSigned(signer,message)@s)"
end
