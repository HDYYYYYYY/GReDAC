theory SACReDCredentialAuthentication
begin
builtins: signing
functions: mac/2, channel_packet/2 [private]
// Interface projection: any successfully registered right may be imported.
// Shared projection erases root: (d,ctx,endpoint,side,holder,holderpk).
// The local root=d placeholder carries NO ancestry or ledger-activation claim.
// Import does not assert policy eligibility, liveness, ownership or admission.
// RequestKey is one selected leaf-secret interface; PCDF is separate.
// Endpoint is ghost registration context, NOT an extra signed M/ACT field.
rule Agent:
 [ Fr(~agent), Fr(~key) ]
 --[ AgentCreated(~agent,~key) ]->
 [ !Agent(~agent,~key), !PublicKey(~agent,pk(~key)),
   Out(<~agent,pk(~key)>) ]

rule CompromiseAgent:
 [ !Agent(agent,key) ]
 --[ AgentCompromised(agent,key) ]->
 [ !Compromised(agent), Out(key) ]

rule ContextInterface:
 [ Fr(~ctx), In(endpoint) ] -->
 [ !Context(~ctx,endpoint), Out(<~ctx,endpoint>) ]

rule ImportRegisteredRight:
 [ !Context(ctx,endpoint), !Agent(holder,key), Fr(~d), In(side) ]
 --[ RightRegistered(~d,~d,ctx,endpoint,side,holder) ]->
 [ !Right(~d,~d,ctx,endpoint,side,holder,pk(key)), Out(~d) ]

rule IssueACT:
 let token = <'act',caller,service,dc,ds,ctx,~sid,expiry>
 in
 [ !Right(dc,rc,ctx,endpoint,'caller',caller,callerpk)[-],
   !Right(ds,rs,ctx,endpoint,'service',service,pk(key))[-],
   !Agent(service,key), Fr(~sid), In(expiry) ]
 --[ ACTIssued(service,token) ]->
 [ Out(<token,sign(token,key)>) ]

// A keyid denotes one actual per-leaf authentication secret selected by
// the state layer. This interface hides PCDF derivation and unit selection.
rule RequestCredential:
 [ !Right(dc,root,ctx,endpoint,'caller',caller,callerpk)[-],
   Fr(~keyid), Fr(~secret) ]
 --[ RequestKeyCreated(~keyid,caller,~secret) ]->
 [ !RequestKey(~keyid,caller,~secret), Out(~keyid) ]

rule CompromisedCredentialDelivery:
 [ !Compromised(caller), !RequestKey(keyid,caller,secret) ]
 --[ RequestKeyRevealed(keyid,caller,secret) ]-> [ Out(secret) ]

// Ghost interface: coalition knowledge of this actual leaf secret, including
// direct sharing, ancestor-capability derivation and future compromised delivery.
// The P1 reachability theorem determines when this event maps to reality.
rule RevealCredential:
 [ !RequestKey(keyid,caller,secret) ]
 --[ RequestKeyRevealed(keyid,caller,secret) ]-> [ Out(secret) ]

rule GenerateTag:
 [ !RequestKey(keyid,caller,secret), In(message) ]
 --[ TagGenerated(keyid,caller,message) ]->
 [ Out(mac(secret,message)) ]

// Ideal authenticated-channel interface. It intentionally does not hide M,
// so network knowledge is overapproximated for these authenticity claims.
// This is not a proposal to add per-request identity signatures.
rule HonestChannelSend:
 [ !Agent(caller,key), In(message) ]
 --[ ChannelSent(caller,message) ]->
 [ Out(<message,channel_packet(pk(key),message)>) ]

rule SendWithKnownIdentityKey:
 [ !PublicKey(caller,pk(key)), In(key), In(message) ]
 --[ ChannelSentWithExposedKey(caller,message) ]->
 [ Out(<message,channel_packet(pk(key),message)>) ]

// A session-key leak is independent of identity-key compromise. This is an
// ideal-channel compromise interface, not a model/proof of a TLS handshake.
rule RevealSession:
 [ !PublicKey(caller,pubkey), In(<service,ctx,sid>) ]
 --[ SessionExposed(caller,service,ctx,sid) ]->
 [ !ExposedSession(caller,service,ctx,sid) ]

rule SendOnExposedSession:
 let message = <'request',rho,ctx,sid,caller,service,dc,ds,action,payload,vector>
 in
 [ !ExposedSession(caller,service,ctx,sid), !PublicKey(caller,pubkey), In(message) ]
 --[ ChannelSentWithExposedSession(caller,service,ctx,sid,message) ]->
 [ Out(<message,channel_packet(pubkey,message)>) ]

rule CheckACT:
 let token = <'act',caller,service,dc,ds,ctx,sid,expiry>
 in
 [ !PublicKey(service,pubkey), In(<token,sig>) ]
 --[ Eq(verify(sig,token,pubkey),true), ACTChecked(service,token) ]->
 [ !VerifiedACT(service,token) ]

rule CheckChannel:
 [ !PublicKey(caller,callerpk), In(<message,channel_packet(callerpk,message)>) ]
 --[ ChannelChecked(caller,message) ]-> [ !VerifiedChannel(caller,message) ]

rule CheckTag:
 [ !RequestKey(keyid,caller,secret), In(<message,mac(secret,message)>) ]
 --[ TagChecked(keyid,caller,message) ]-> [ !VerifiedTag(keyid,caller,message) ]

rule VerifyRequest:
 let token = <'act',caller,service,dc,ds,ctx,sid,expiry>
     message = <'request',rho,ctx,sid,caller,service,dc,ds,action,payload,vector>
 in
 [ !Right(dc,rc,ctx,endpoint,'caller',caller,callerpk),
   !Right(ds,rs,ctx,endpoint,'service',service,servicepk),
   !VerifiedACT(service,token), !VerifiedChannel(caller,message),
   !VerifiedTag(keyid,caller,message) ]
 --[ BilateralChecked(dc,ds,ctx,endpoint,caller,service),
     CryptoVerified(caller,service,dc,ds,ctx,endpoint,sid,keyid,message) ]-> []

restriction Equality:
 "All x y #i. Eq(x,y)@i ==> x = y"

lemma identity_knowledge_requires_compromise [reuse]:
 "All agent key #c #k. AgentCreated(agent,key)@c & K(key)@k
  ==> (Ex #r. AgentCompromised(agent,key)@r & r < k)"

lemma request_secret_requires_exposure [reuse]:
 "All keyid caller secret #c #k.
  RequestKeyCreated(keyid,caller,secret)@c & K(secret)@k
  ==> (Ex #r. RequestKeyRevealed(keyid,caller,secret)@r & r < k)"

lemma act_origin_or_service_compromise:
 "All service token #r. ACTChecked(service,token)@r
  ==> (Ex #s. ACTIssued(service,token)@s & s < r)
    | (Ex key #c. AgentCompromised(service,key)@c & c < r)"

lemma authenticated_message_origin_or_identity_or_session_exposure:
 "All caller service ctx sid rho dc ds action payload vector #r.
  ChannelChecked(caller,<'request',rho,ctx,sid,caller,service,dc,ds,action,payload,vector>)@r
  ==> (Ex #s. ChannelSent(caller,
       <'request',rho,ctx,sid,caller,service,dc,ds,action,payload,vector>)@s & s < r)
    | (Ex key #c. AgentCompromised(caller,key)@c & c < r)
    | (Ex #c. SessionExposed(caller,service,ctx,sid)@c & c < r)"

lemma complete_message_tag_origin_or_secret_exposure:
 "All keyid caller message #r. TagChecked(keyid,caller,message)@r
  ==> (Ex #s. TagGenerated(keyid,caller,message)@s & s < r)
    | (Ex secret #c. RequestKeyRevealed(keyid,caller,secret)@c & c < r)"

lemma verified_request_has_both_registered_sides:
 "All dc ds ctx endpoint caller service #r.
  BilateralChecked(dc,ds,ctx,endpoint,caller,service)@r
  ==> (Ex rc rs #c #s.
       RightRegistered(dc,rc,ctx,endpoint,'caller',caller)@c
     & RightRegistered(ds,rs,ctx,endpoint,'service',service)@s
     & c < r & s < r)"

lemma verified_request_has_three_matching_checks:
 "All caller service dc ds ctx endpoint sid keyid rho action payload vector #r.
  CryptoVerified(caller,service,dc,ds,ctx,endpoint,sid,keyid,
    <'request',rho,ctx,sid,caller,service,dc,ds,action,payload,vector>)@r
  ==> (Ex expiry #a #c #t.
       ACTChecked(service,<'act',caller,service,dc,ds,ctx,sid,expiry>)@a
     & ChannelChecked(caller,
       <'request',rho,ctx,sid,caller,service,dc,ds,action,payload,vector>)@c
     & TagChecked(keyid,caller,
       <'request',rho,ctx,sid,caller,service,dc,ds,action,payload,vector>)@t
     & a < r & c < r & t < r)"

lemma distinct_bilateral_request_exists:
 exists-trace
 "Ex caller service dc ds ctx endpoint sid keyid message #r.
  CryptoVerified(caller,service,dc,ds,ctx,endpoint,sid,keyid,message)@r
  & not(caller = service) & not(dc = ds)
  & not(Ex who key #c. AgentCompromised(who,key)@c)
  & not(Ex id who secret #c. RequestKeyRevealed(id,who,secret)@c)
  & not(Ex who peer coll sess #c. SessionExposed(who,peer,coll,sess)@c)"

lemma compromised_caller_can_make_verified_request:
 exists-trace
 "Ex caller key service dc ds ctx endpoint sid keyid message #c #r.
  AgentCompromised(caller,key)@c
  & CryptoVerified(caller,service,dc,ds,ctx,endpoint,sid,keyid,message)@r
  & c < r & not(caller = service)"
lemma same_session_two_fresh_request_credentials:
 exists-trace
 "Ex caller service dc ds ctx endpoint sid k1 k2 m1 m2 #r1 #r2.
  CryptoVerified(caller,service,dc,ds,ctx,endpoint,sid,k1,m1)@r1
  & CryptoVerified(caller,service,dc,ds,ctx,endpoint,sid,k2,m2)@r2
  & r1 < r2 & not(k1 = k2) & not(m1 = m2)
  & not(caller = service)
  & not(Ex who key #c. AgentCompromised(who,key)@c)
  & not(Ex id who secret #c. RequestKeyRevealed(id,who,secret)@c)
  & not(Ex who peer coll sess #c. SessionExposed(who,peer,coll,sess)@c)"
lemma session_leak_can_impersonate_without_identity_leak:
 exists-trace
 "Ex caller service ctx sid rho dc ds action payload vector #e #c.
  SessionExposed(caller,service,ctx,sid)@e
  & ChannelChecked(caller,<'request',rho,ctx,sid,caller,service,dc,ds,action,payload,vector>)@c
  & e < c
  & not(Ex #s. ChannelSent(caller,
       <'request',rho,ctx,sid,caller,service,dc,ds,action,payload,vector>)@s)
  & not(Ex who key #r. AgentCompromised(who,key)@r)"
end
