(set-option :timeout 20000)
(set-logic QF_NRA)
(declare-const Q Real)
(declare-const T Real)
(declare-const V Real)
(declare-const D Real)
(assert (>= Q 0))
(assert (>= T 0))
(assert (>= V 0))
(define-fun N () Real (+ Q T))
(define-fun B () Real (+ Q T V 2))
; D > 16 B^2 implies D - 4 B > D/2.
(assert (> D (* 16 B B)))
(assert (not (> (- D (* 4 B)) (/ D 2))))
(check-sat)
