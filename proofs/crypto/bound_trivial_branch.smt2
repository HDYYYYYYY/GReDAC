(set-option :timeout 20000)
(set-logic QF_NRA)
(declare-const Q Real)
(declare-const T Real)
(declare-const V Real)
(declare-const D Real)
(assert (>= Q 0))
(assert (>= T 0))
(assert (>= V 0))
(define-fun N () Real (+ Q T))
(define-fun B () Real (+ Q T V 2))
; In the other branch the advertised bound is at least 1.
(assert (> D 0))
(assert (<= D (* 16 B B)))
(assert (not (>= (/ (* 16 B B) D) 1)))
(check-sat)
